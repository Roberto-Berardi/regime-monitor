<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Roberto Berardi — sections 1 & 2</title>
<style>
:root{
  --ink:#0B1F2A; --navy:#0D3B4F;
  --long:#6D4AE0; --long-soft:#F1EDFE; --long-deep:#4A2FB8; --long-line:#DDD3FA;
  --short:#C08A20; --short-soft:#FBF4E3; --short-deep:#8A6110; --short-line:#EEDFB8;
  --c1:#1f77b4; --c2:#ff7f0e; --c3:#7f7f7f; --green:#0E7C5A;
  --teal:#0FA396; --teal-2:#4FBFB6;
  --grey:#8A99A2; --line:#E1E8EB; --soft:#F6F9FA; --body:#4E5D65;
  --sans:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,sans-serif;
  --serif:Georgia,"Iowan Old Style","Times New Roman",serif;
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
body{margin:0;background:#fff;color:var(--ink);font-family:var(--sans);
  font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3{margin:0}
.c{width:min(1180px,calc(100% - 40px));margin:0 auto}

/* ═══ HERO ═══ */
.hero{background:linear-gradient(135deg,#0B3245 0%,#134C64 52%,#186079 100%);
  color:#fff;padding:54px 0 44px;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;right:-200px;top:-220px;width:600px;height:600px;
  border-radius:50%;background:radial-gradient(circle,rgba(15,163,150,.3),transparent 68%)}
.hero:after{content:"";position:absolute;left:-140px;bottom:-280px;width:460px;height:460px;
  border-radius:50%;background:radial-gradient(circle,rgba(109,74,224,.22),transparent 70%)}
.hero-in{display:flex;gap:34px;align-items:center;position:relative;z-index:2;flex-wrap:wrap}
.avatar{width:128px;height:128px;flex:0 0 128px;border-radius:50%;
  background:rgba(255,255,255,.07);border:2px solid rgba(255,255,255,.22);
  display:grid;place-items:center;font-size:10.5px;color:rgba(255,255,255,.5);
  letter-spacing:.06em;overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover}
.hero h1{font-size:clamp(38px,5.4vw,56px);line-height:1;letter-spacing:-.04em;
  margin-bottom:10px;font-weight:800}
.cred{font-size:15px;color:var(--teal-2);font-weight:650;margin:0 0 13px}
.intro{font-size:16.5px;color:rgba(255,255,255,.86);max-width:60ch;margin:0 0 22px;line-height:1.5}
.intro b{color:#fff;font-weight:700}
.hlinks{display:flex;gap:9px;flex-wrap:wrap}
.hlinks a{padding:9px 18px;border-radius:999px;font-size:13px;font-weight:650;
  text-decoration:none;color:#fff;background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.2);transition:background .15s}
.hlinks a:hover{background:rgba(255,255,255,.2)}
.hlinks a.solid{background:var(--teal);border-color:var(--teal);color:#04302C}
.hlinks a.ph{opacity:.5}
.fresh{width:250px;flex:0 0 250px;border-left:1px solid rgba(255,255,255,.16);
  padding-left:22px;position:relative;z-index:2}
.fresh>div{padding:0 0 13px;margin-bottom:13px;border-bottom:1px solid rgba(255,255,255,.12)}
.fresh>div:last-child{padding-bottom:0;margin-bottom:0;border-bottom:0}
.f-lbl{font-size:9px;letter-spacing:.14em;text-transform:uppercase;
  color:rgba(255,255,255,.5);margin-bottom:3px}
.f-val{font-family:var(--mono);font-size:13.5px;font-weight:600}
.f-sub{font-size:10.5px;color:rgba(255,255,255,.44);margin-top:1px}
.pulse{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--teal);
  box-shadow:0 0 0 3px rgba(15,163,150,.25);margin-right:6px;vertical-align:middle}

/* ═══ QUESTION ═══ */
.question{background:#08222F;color:#fff;padding:60px 0}
.question p{font-family:var(--serif);margin:0;max-width:none;
  font-size:clamp(22px,2.9vw,34px);line-height:1.3;letter-spacing:-.015em}
.question .b{display:block;max-width:none;margin-top:12px;
  color:rgba(255,255,255,.56);font-size:clamp(18px,2.4vw,27px)}

/* ═══ MECHANISM ═══ */
.mech{padding:46px 0 52px;border-bottom:1px solid var(--line)}
.mech .date{font-size:12px;color:var(--grey);margin-bottom:22px}
.mech .rule2{height:2px;background:var(--ink);margin-bottom:26px}
.sec-h{font-size:10px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--grey);font-weight:700;margin-bottom:10px}
.mech h2{font-family:var(--serif);font-size:28px;font-weight:600;
  letter-spacing:-.01em;margin-bottom:6px}
.step-lbl{display:flex;align-items:baseline;gap:11px;margin:0 0 16px;flex-wrap:wrap}
.step-lbl .n{font-family:var(--mono);font-size:12px;font-weight:800;color:var(--teal)}
.step-lbl .t{font-size:17.5px;font-weight:700;letter-spacing:-.015em}
.step-lbl .x{font-size:15px;color:var(--body);font-weight:500;line-height:1.5}

.boxes{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:30px}
.box{padding:22px 26px;border-radius:14px;border-top:4px solid var(--bc);
  background:linear-gradient(180deg,var(--bg),#fff 78%)}
.box.fall{--bc:var(--long);--bg:var(--long-soft)}
.box.rise{--bc:var(--short);--bg:var(--short-soft)}
.box.plain{--bc:var(--navy);--bg:var(--soft)}
.box .dir{display:flex;align-items:center;gap:10px;font-size:13px;letter-spacing:.1em;
  text-transform:uppercase;font-weight:800;margin-bottom:12px}
.box.fall .dir{color:var(--long-deep)}
.box.rise .dir{color:var(--short-deep)}
.box.plain .dir{color:var(--navy)}
.box .dir .ar{font-size:20px;line-height:1}
.box .claim{margin:0 0 16px;font-size:16px;color:var(--ink);line-height:1.5;font-weight:600}
.box .claim:last-child{margin-bottom:0}
.names{display:flex;gap:10px;flex-wrap:wrap}
.names span{font-family:var(--mono);font-size:13.5px;font-weight:700;
  padding:7px 14px;border-radius:8px;background:#fff}
.box.fall .names span{color:var(--long-deep);border:1px solid var(--long-line)}
.box.rise .names span{color:var(--short-deep);border:1px solid var(--short-line)}
.box .metric{font-family:var(--mono);font-size:13px;color:var(--navy);
  background:#fff;border:1px solid var(--line);border-radius:8px;
  padding:8px 12px;margin-bottom:14px;display:inline-block}

.axis-line{background:var(--soft);border-left:3px solid var(--navy);
  border-radius:0 12px 12px 0;padding:18px 22px;margin-bottom:32px;
  font-size:16.5px;line-height:1.55;color:var(--ink)}
.axis-line b{font-weight:750}

.rules{display:grid;grid-template-columns:repeat(3,1fr);gap:0;
  border:1px solid var(--line);border-radius:12px;overflow:hidden}
.rule{padding:20px 24px}
.rule+.rule{border-left:1px solid var(--line)}
.rule .h{font-size:9px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--grey);font-weight:700;margin-bottom:8px}
.rule .v{font-family:var(--mono);font-size:18px;font-weight:800;
  color:var(--navy);margin-bottom:9px}
.rule p{margin:0;font-size:15px;color:var(--body);line-height:1.5}

/* ══════ SECTION 2 ══════ */
.s2{font-family:var(--serif);padding:46px 0 52px;border-bottom:1px solid var(--line)}
.s2 .kicker{font-family:var(--sans);font-size:10px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--grey);font-weight:700;margin-bottom:10px}
.s2 h2{font-size:28px;font-weight:600;letter-spacing:-.01em;margin-bottom:6px}
.s2 .date{font-family:var(--sans);font-size:12px;color:var(--grey);margin-bottom:22px}
.s2 .rule2{height:2px;background:var(--ink);margin-bottom:26px}

.stance-box{background:linear-gradient(180deg,#FCF7EA,#fff 85%);
  border:1px solid var(--short-line);border-radius:16px;padding:28px 32px;
  box-shadow:0 8px 26px rgba(11,31,42,.09);margin-bottom:34px}
.stance-box .lbl{font-family:var(--sans);font-size:9.5px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--short-deep);font-weight:800;margin-bottom:12px}
.stance-box p{font-size:19px;line-height:1.6;margin:0;max-width:76ch}
.stance-box b{font-weight:700}

/* score gauge — label above the dot, numbers below the track */
.gauge-wrap{margin-bottom:32px}
.gauge-h{font-family:var(--sans);font-size:9.5px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--grey);font-weight:700;margin-bottom:16px}
.gauge{position:relative;height:96px;font-family:var(--sans)}
.gauge .cap{position:absolute;top:0;font-size:10px;letter-spacing:.1em;
  text-transform:uppercase;font-weight:700}
.gauge .cap.l{left:0;color:var(--long-deep)}
.gauge .cap.r{right:0;color:var(--short-deep)}
.gauge .tag{position:absolute;top:22px;transform:translateX(-50%);
  font-family:var(--mono);font-size:12.5px;font-weight:800;color:var(--short-deep);
  white-space:nowrap;background:#fff;padding:0 6px}
.gauge .dot{position:absolute;top:45px;width:20px;height:20px;border-radius:50%;
  background:var(--short);border:4px solid #fff;
  box-shadow:0 2px 8px rgba(11,31,42,.3);transform:translateX(-50%);z-index:2}
.gauge .track{position:absolute;left:0;right:0;top:51px;height:8px;border-radius:4px;
  background:linear-gradient(90deg,var(--long),#D8DDE1 46%,#D8DDE1 54%,var(--short))}
.gauge .stop{position:absolute;top:47px;width:2px;height:16px;background:#fff;
  transform:translateX(-50%)}
.gauge .num{position:absolute;top:72px;font-family:var(--mono);font-size:11px;
  color:var(--grey);transform:translateX(-50%)}
.gauge .num.on{color:var(--short-deep);font-weight:800}

.bands{font-family:var(--sans);border:1px solid var(--line);
  border-radius:12px;overflow:hidden}
.band{display:grid;grid-template-columns:96px 1fr auto;gap:16px;align-items:center;
  padding:13px 18px;font-size:14px}
.band+.band{border-top:1px solid var(--line)}
.band.live{background:var(--short-soft)}
.band .sc{font-family:var(--mono);font-weight:700}
.band.l .sc{color:var(--long-deep)}
.band.n .sc{color:var(--grey)}
.band.s .sc{color:var(--short-deep)}
.band .now{font-size:9px;letter-spacing:.1em;text-transform:uppercase;
  font-weight:800;color:var(--short-deep)}

/* allocation */
.alloc{font-family:var(--sans);display:grid;grid-template-columns:auto 1fr 1fr;
  gap:36px;margin-top:34px;align-items:center}
.alloc-h{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--grey);font-weight:700;margin-bottom:14px}
.lrow{display:flex;justify-content:space-between;align-items:center;
  font-size:13.5px;padding:7px 0;border-bottom:1px solid var(--line)}
.lrow:last-child{border-bottom:0}
.lrow i{width:9px;height:9px;border-radius:2px;display:inline-block;
  margin-right:9px;vertical-align:-1px}
.lrow .v{font-family:var(--mono);font-weight:700}
.lrow.dim{color:var(--grey)}
.split{font-size:13.5px;display:flex;justify-content:space-between;
  padding:7px 0;border-bottom:1px solid var(--line)}
.split:last-child{border-bottom:0}
.split b{font-family:var(--mono);font-weight:700}



.alloc2{font-family:var(--sans);display:grid;grid-template-columns:1.25fr 1fr;
  gap:38px;margin-top:16px;align-items:start}
.groups{display:grid;gap:0;border:1px solid var(--line);border-radius:12px;
  overflow:hidden}
.grp{padding:16px 20px}
.grp+.grp{border-top:1px solid var(--line)}
.grp.long{--gc:var(--long)}
.grp.short{--gc:var(--short)}
.grp.def{--gc:#5A6C75}
.ghd{display:flex;justify-content:space-between;align-items:baseline;
  margin-bottom:9px}
.gname{font-size:14.5px;font-weight:700;color:var(--gc)}
.gmove{font-family:var(--mono);font-size:13px;color:var(--grey)}
.gmove s{opacity:.65}
.gmove b{color:var(--ink);font-weight:700}
.gbar{height:7px;border-radius:4px;background:var(--soft);margin-bottom:11px;
  overflow:hidden}
.gbar i{display:block;height:100%;background:var(--gc);border-radius:4px}
.gassets{display:grid;gap:5px}
.gassets div{display:flex;justify-content:space-between;font-size:13.5px;
  color:var(--body)}
.gassets .v{font-family:var(--mono);font-weight:700;color:var(--ink)}
.gassets .off{color:var(--grey)}
.gassets .off .v{color:var(--grey);font-weight:500}
.gnote{margin:11px 0 0;font-size:12px;color:var(--grey);line-height:1.5}
.tilt-tbl{display:grid;grid-template-columns:1fr auto auto auto;
  gap:0 14px;font-size:13px;align-items:center}
.tilt-tbl .th{font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--grey);font-weight:700;text-align:right;padding-bottom:7px;
  border-bottom:1px solid var(--line)}
.tilt-tbl .rl{padding:8px 0;border-bottom:1px solid var(--line)}
.tilt-tbl .rv{font-family:var(--mono);text-align:right;padding:8px 0;
  border-bottom:1px solid var(--line);color:var(--grey)}
.tilt-tbl .rv.d{color:var(--short-deep);font-weight:700}
.tilt-tbl .rv.now{color:var(--ink);font-weight:700}
.formula{font-family:var(--mono);font-size:12px;color:var(--body);
  background:var(--soft);border-radius:8px;padding:12px 14px;margin-top:14px;
  line-height:1.7}
.formula b{color:var(--short-deep)}
.tilt-note{font-size:12.5px;color:var(--body);line-height:1.55;margin:12px 0 0}
.tilt-note b{color:var(--ink);font-weight:700}
.params{font-family:var(--sans);display:grid;grid-template-columns:1fr 1fr 1fr;
  gap:16px;margin-top:34px}
.pcard{border:1px solid var(--line);border-radius:12px;padding:18px 20px}
.pcard .h{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--grey);font-weight:700;margin-bottom:10px}
.pcard .move{font-family:var(--mono);font-size:15px;font-weight:700;margin-bottom:4px}
.pcard .move .d{color:var(--short-deep)}
.pcard .win{font-family:var(--mono);font-size:11.5px;color:var(--grey);margin-bottom:4px}
.pcard .obs{font-size:11px;color:var(--grey);margin-bottom:10px}
.pcard a{font-size:12px;color:var(--teal);text-decoration:none;font-weight:650}
.pcard a:hover{text-decoration:underline}
.pcard .dl{display:grid;grid-template-columns:auto 1fr;gap:7px 16px;font-size:12.5px;margin:0}
.pcard .dl dt{color:var(--grey)}
.pcard .dl dd{margin:0;font-family:var(--mono);font-weight:650;text-align:right}

.foot{font-family:var(--sans);font-size:12.5px;color:var(--grey);
  margin-top:26px;padding-top:16px;border-top:1px solid var(--line);
  line-height:1.6;max-width:88ch}
.foot b{color:var(--ink)}

.s3{font-family:var(--serif);padding:46px 0 52px;border-bottom:1px solid var(--line)}
.s3 .kicker{font-family:var(--sans);font-size:10px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--grey);font-weight:700;margin-bottom:10px}
.s3 h2{font-size:28px;font-weight:600;letter-spacing:-.01em;margin-bottom:6px}
.s3 .date{font-family:var(--sans);font-size:12px;color:var(--grey);margin-bottom:22px}
.s3 .rule2{height:2px;background:var(--ink);margin-bottom:26px}
.s3 .summary{font-size:18px;line-height:1.6;margin:0 0 28px;max-width:78ch}
.s3 .summary b{font-weight:700}

.ctrl{font-family:var(--sans);display:flex;justify-content:space-between;
  align-items:center;gap:20px;margin-bottom:16px;flex-wrap:wrap}
.tabs{display:flex;border:1px solid var(--line);border-radius:4px;overflow:hidden}
.tab{padding:7px 17px;border:0;background:#fff;color:#6B7A82;cursor:pointer;
  font:inherit;font-size:12.5px;font-weight:600}
.tab+.tab{border-left:1px solid var(--line)}
.tab.on{background:var(--navy);color:#fff}
.range{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--grey)}
.range input{font:inherit;font-family:var(--mono);font-size:12px;padding:6px 9px;
  border:1px solid var(--line);border-radius:4px;color:var(--ink);background:#fff}
.range button{font:inherit;font-size:12px;font-weight:600;padding:6px 14px;
  border:1px solid var(--navy);background:#fff;color:var(--navy);
  border-radius:4px;cursor:pointer}
.range button:hover{background:var(--navy);color:#fff}

.fig{font-family:var(--sans);position:relative;border-top:1px solid var(--ink);
  border-bottom:1px solid var(--line);padding:18px 0 14px}
.fig-t{font-size:13px;font-weight:650;margin-bottom:2px}
.fig-s{font-size:11.5px;color:var(--grey);margin-bottom:14px;font-family:var(--mono)}
.s3 svg{width:100%;height:auto;display:block}
.tip{position:absolute;pointer-events:none;display:none;z-index:5;background:#fff;
  border:1px solid var(--ink);padding:10px 13px;font-family:var(--mono);font-size:11.5px;
  line-height:1.7;box-shadow:2px 3px 0 rgba(11,31,42,.12);white-space:nowrap}
.tip .d{font-weight:700;border-bottom:1px solid var(--line);
  padding-bottom:5px;margin-bottom:6px}
.tip .h{font-size:9px;letter-spacing:.09em;color:#8A99A2;font-family:var(--sans);
  font-weight:700;margin:7px 0 3px}
.tip i{display:inline-block;width:16px;height:2.5px;margin-right:8px;vertical-align:3px}
.tip .r{display:flex;justify-content:space-between;gap:22px}
.tip .r b{font-weight:700}

.kpis{font-family:var(--sans);display:grid;grid-template-columns:repeat(6,1fr);
  border:1px solid var(--line);border-left:0;margin-top:20px}
.kpi{padding:14px 16px;border-left:1px solid var(--line)}
.kpi .k{font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--grey);
  font-weight:700}
.kpi b{display:block;font-family:var(--mono);font-size:18px;margin-top:6px;font-weight:700}
.kpi small{display:block;font-size:10.5px;color:var(--grey);margin-top:3px;
  font-family:var(--mono)}
.kpi.win b{color:var(--green)}
.kpi small.ref{color:#AEB9C0}

.costnote{font-family:var(--sans);font-size:12.5px;color:var(--grey);
  margin-top:12px;line-height:1.55}
.costnote b{color:var(--ink)}

.verdict{font-family:var(--sans);margin-top:22px;padding:20px 24px;
  border-left:3px solid var(--navy);background:var(--soft);
  font-size:14.5px;color:#3B4A52;line-height:1.6}
.verdict b{color:var(--ink)}

.two{font-family:var(--sans);display:grid;grid-template-columns:1fr 1.15fr;
  gap:34px;margin-top:34px;align-items:start}
.blk-h{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--grey);font-weight:700;margin-bottom:14px}
.s3 table{width:100%;border-collapse:collapse;font-size:13.5px}
.s3 th{text-align:right;font-size:9px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--grey);font-weight:700;padding:0 0 8px;border-bottom:1.5px solid var(--ink)}
.s3 th:first-child{text-align:left}
.s3 td{text-align:right;padding:11px 0;border-bottom:1px solid var(--line);
  font-family:var(--mono)}
.s3 td:first-child{text-align:left;font-family:var(--sans)}
.s3 tr:last-child td{border-bottom:0}
.s3 .gain{color:var(--green);font-weight:700}
.s3 tr.pick td{background:var(--short-soft);font-weight:700}
.s3 tr.pick td:first-child{color:var(--short-deep)}
.pnote{font-size:12.5px;color:var(--grey);line-height:1.55;margin:12px 0 0}
.pnote b{color:var(--ink)}


.s4{font-family:var(--serif);padding:46px 0 52px;border-bottom:1px solid var(--line)}
.s4 .kicker{font-family:var(--sans);font-size:10px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--grey);font-weight:700;margin-bottom:10px}
.s4 h2{font-size:28px;font-weight:600;letter-spacing:-.01em;margin-bottom:6px}
.s4 .date{font-family:var(--sans);font-size:12px;color:var(--grey);margin-bottom:22px}
.s4 .rule2{height:2px;background:var(--ink);margin-bottom:26px}
.s4 .lead{font-size:18px;line-height:1.6;margin:0 0 26px;max-width:80ch}
.s4 .lead b{font-weight:700}

.conds{font-family:var(--sans);display:grid;grid-template-columns:repeat(3,1fr);
  border:1px solid var(--line);margin-bottom:36px}
.cond{padding:24px 26px}
.cond+.cond{border-left:1px solid var(--line)}
.cond .n{font-family:var(--mono);font-size:13px;font-weight:800;color:var(--teal);
  margin-bottom:10px}
.cond .t{font-size:17px;font-weight:700;margin-bottom:8px;line-height:1.35;
  letter-spacing:-.01em}
.cond p{margin:0;font-size:14.5px;color:var(--body);line-height:1.55}

.s4 .blk-h{font-family:var(--serif);font-size:21px;font-weight:700;color:var(--ink);
  letter-spacing:-.015em;margin-bottom:14px}
.s4 table{width:100%;border-collapse:collapse;font-family:var(--sans);
  margin-bottom:34px}
.s4 th{text-align:left;font-size:9px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--grey);font-weight:700;padding:0 16px 9px 0;
  border-bottom:1.5px solid var(--ink)}
.s4 td{padding:14px 16px 14px 0;border-bottom:1px solid var(--line);
  font-size:14px;line-height:1.5;vertical-align:top}
.s4 td:first-child{width:34%;font-weight:650}
.s4 tr:last-child td{border-bottom:0}
.s4 tr.kept td{background:#F1FAF6}
.s4 tr.kept td:first-child{color:var(--green);font-weight:700}
.tag{font-size:9px;letter-spacing:.1em;text-transform:uppercase;font-weight:800;
  padding:3px 9px;margin-right:9px;white-space:nowrap}
.tag.k{background:#E4F4EC;color:#0A6B4C;border:1px solid #A9DCC5}
.tag.r{background:#FDEDEC;color:#A32B25;border:1px solid #F2C9C6}

.method{padding:24px 28px;background:var(--soft);border-left:3px solid var(--navy)}
.method .q{font-family:var(--serif);font-size:21px;font-weight:700;
  color:var(--ink);letter-spacing:-.015em;margin-bottom:10px}
.method p{font-family:var(--sans);margin:0;font-size:14.5px;line-height:1.6;
  color:#3B4A52;max-width:none}
.method b{color:var(--ink);font-weight:700}
.method .five{font-family:var(--mono);font-weight:700;color:var(--navy)}



footer{background:var(--navy);color:rgba(255,255,255,.62);padding:38px 0 46px;
  font-family:var(--sans);font-size:12.5px;line-height:1.7}
footer a{color:rgba(255,255,255,.92);text-decoration:none;font-weight:600}
footer a:hover{text-decoration:underline}
.f-top{display:flex;justify-content:space-between;gap:28px;flex-wrap:wrap;
  padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid rgba(255,255,255,.14)}
.f-src{max-width:60ch}
.f-src b{color:rgba(255,255,255,.9);font-weight:650}
.f-links{display:flex;gap:20px;flex-wrap:wrap;align-items:flex-start}
.f-links a.ph{opacity:.5}
.f-legal{font-size:12px;color:rgba(255,255,255,.5);max-width:100ch}

@media(max-width:980px){
  .boxes,.rules,.params{grid-template-columns:1fr}
  .rule+.rule{border-left:0;border-top:1px solid var(--line)}
  .alloc{grid-template-columns:1fr}
    .fresh{width:100%;flex:1 1 100%;border-left:0;padding-left:0;
    border-top:1px solid rgba(255,255,255,.16);padding-top:18px;margin-top:6px}
}
@media(max-width:980px){
  .s3 .kpis{grid-template-columns:repeat(2,1fr)}
  .s3 .two{grid-template-columns:1fr}
}


@media(max-width:980px){
  .conds{grid-template-columns:1fr}
  .cond+.cond{border-left:0;border-top:1px solid var(--line)}
  .s4 td:first-child{width:auto}
  .s4 thead{display:none}
  .s4 tr{display:block;border-bottom:1px solid var(--line);padding:12px 0}
  .s4 td{display:block;border:0;padding:3px 0}
}
</style>
</head>
<body>

<!-- ══════════ HERO ══════════ -->
<div class="hero">
  <div class="c hero-in">
    <div class="avatar">PHOTO</div>
    <div style="flex:1;min-width:300px">
      <h1>Roberto Berardi</h1>
      <p class="cred">MSc Finance, HEC Lausanne · Asset and Risk Management</p>
      <p class="intro">
        A systematic multi-asset portfolio positioned by monetary conditions.
        Rebuilt from live data every weekday. The book rebalances monthly.
        This is the position it holds today, <b>not a backtest</b>.
      </p>
      <div class="hlinks">
        <a class="solid ph" href="#">Email</a>
        <a class="ph" href="#">LinkedIn</a>
        <a class="ph" href="#">CV (PDF)</a>
        <a href="#" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="fresh">
      <div>
        <div class="f-lbl">Market data through</div>
        <div class="f-val"><span class="pulse"></span>{{ data_as_of }}</div>
        <div class="f-sub">Rebuilt every weekday</div>
      </div>
      <div>
        <div class="f-lbl">Weights last set</div>
        <div class="f-val">{{ weights_set_on }}</div>
        <div class="f-sub">Monthly rebalance</div>
      </div>
      <div>
        <div class="f-lbl">Risk anchor</div>
        <div class="f-val">{{ budget_pct }}% risk / {{ defensive_pct }}% defensive</div>
        <div class="f-sub">Policy, not optimised</div>
      </div>
    </div>
  </div>
</div>

<!-- ══════════ QUESTION ══════════ -->
<div class="question">
  <div class="c">
    <p>
      When the Fed moves, which assets should you own?
      <span class="b">And is that a real edge, or just a story we tell?</span>
    </p>
  </div>
</div>

<!-- ══════════ MECHANISM ══════════ -->
<div class="mech">
  <div class="c">
    <div class="sec-h">The mechanism</div>
    <h2>How the position is decided</h2>

    <div class="step-lbl">
      <span class="n">01</span>
      <span class="t">Why rates move asset prices</span>
      <span class="x">Interest rates set the discount rate on future cash flows.</span>
    </div>

    <div class="boxes">
      <div class="box fall">
        <div class="dir"><span class="ar">↓</span> When rates fall</div>
        <p class="claim">Assets whose value sits far in the future are worth more.</p>
        <div class="names"><span>Growth equity</span><span>Gold</span></div>
      </div>
      <div class="box rise">
        <div class="dir"><span class="ar">↑</span> When rates rise</div>
        <p class="claim">Assets that generate cash today are worth more.</p>
        <div class="names"><span>Value equity</span><span>Energy</span></div>
      </div>
    </div>

    <div class="axis-line">
      That sensitivity is called <b>equity duration</b>. Every holding is sorted
      from the most rate-sensitive to the least.
    </div>

    <div class="step-lbl">
      <span class="n">02</span>
      <span class="t">What the model reads</span>
      <span class="x">Two observable inputs, both published daily and never revised.</span>
    </div>

    <div class="boxes">
      <div class="box plain">
        <div class="dir">The price of money</div>
        <div class="metric">2-year Treasury yield · 3-month change</div>
        <p class="claim">What the market expects the Fed to do next.</p>
      </div>
      <div class="box plain">
        <div class="dir">The quantity of money</div>
        <div class="metric">Fed balance sheet · 13-week change</div>
        <p class="claim">How much cash the Fed is putting into the system.</p>
      </div>
    </div>

    <div class="step-lbl">
      <span class="n">03</span>
      <span class="t">How the two combine</span>
      <span class="x">A small move is noise, not a signal.</span>
    </div>

    <div class="rules">
      <div class="rule">
        <div class="h">Thresholds</div>
        <div class="v">±25bp · ±1%</div>
        <p>One Fed step on the yield, one per cent on the balance sheet. Smaller
          is neutral.</p>
      </div>
      <div class="rule">
        <div class="h">Weights</div>
        <div class="v">±2 · ±1</div>
        <p>Rates count double: the discount-rate effect is arithmetic, the
          liquidity effect depends on where investors put the cash.</p>
      </div>
      <div class="rule">
        <div class="h">Result</div>
        <div class="v">−3 to +3</div>
        <p>A single score, setting how far the book leans — at most ten
          percentage points.</p>
      </div>
    </div>
  </div>
</div>

<!-- ══════════ SECTION 2 ══════════ -->
<div class="s2">
  <div class="c">
    <div class="kicker">Tactical positioning</div>
    <h2>Current allocation stance</h2>
    <div class="date">Latest observation {{ obs_long }} · reviewed monthly</div>
    <div class="rule2"></div>

    <div class="stance-box">
      <div class="lbl">The reading today</div>
      <p>{{ stance_sentence }}</p>
    </div>

    <div class="gauge-wrap">
      <div class="gauge-h">Score</div>
      <div class="gauge">
        <span class="cap l">Long duration</span>
        <span class="cap r">Short duration</span>
        <div class="tag" style="left:{{ gauge_pct }}%">{{ gauge_label }}</div>
        <div class="dot" style="left:{{ gauge_pct }}%"></div>
        <div class="track"></div>
        <div class="stop" style="left:16.67%"></div>
        <div class="stop" style="left:33.33%"></div>
        <div class="stop" style="left:50%"></div>
        <div class="stop" style="left:66.67%"></div>
        <div class="stop" style="left:83.33%"></div>
        <span class="num{{ ' on' if score == 3 else '' }}" style="left:1%">+3</span>
        <span class="num{{ ' on' if score == 2 else '' }}" style="left:16.67%">+2</span>
        <span class="num{{ ' on' if score == 1 else '' }}" style="left:33.33%">+1</span>
        <span class="num{{ ' on' if score == 0 else '' }}" style="left:50%">0</span>
        <span class="num{{ ' on' if score == -1 else '' }}" style="left:66.67%">−1</span>
        <span class="num{{ ' on' if score == -2 else '' }}" style="left:83.33%">−2</span>
        <span class="num{{ ' on' if score == -3 else '' }}" style="left:99%">−3</span>
      </div>

      <div class="bands">
        <div class="band l{{ ' live' if score > 0 else '' }}">
          <span class="sc">+1 to +3</span>
          <span>Rates falling, liquidity expanding — shift toward long duration</span>
          <span class="now">{{ 'Current' if score > 0 else '' }}</span>
        </div>
        <div class="band n{{ ' live' if score == 0 else '' }}">
          <span class="sc">0</span>
          <span>Neither driver beyond its threshold — no tactical adjustment</span>
          <span class="now">{{ 'Current' if score == 0 else '' }}</span>
        </div>
        <div class="band s{{ ' live' if score < 0 else '' }}">
          <span class="sc">−1 to −3</span>
          <span>Rates rising, liquidity contracting — shift toward short duration</span>
          <span class="now">{{ 'Current' if score < 0 else '' }}</span>
        </div>
      </div>
    </div>

    <div class="alloc-h" style="font-family:var(--sans)">Allocation
      <span style="text-transform:none;letter-spacing:0;font-weight:500;
        color:var(--grey);margin-left:8px">all weights are percentages of the
        total portfolio</span></div>

    <div class="alloc2">
      <div class="groups">

        <div class="grp long">
          <div class="ghd">
            <span class="gname">Long duration</span>
            <span class="gmove"><s>{{ neutral_long }}</s> → <b>{{ w_long }}</b></span>
          </div>
          <div class="gbar"><i style="width:{{ w_long_raw }}%"></i></div>
          <div class="gassets">
            <div><span>Growth · IWF</span><span class="v">{{ w.IWF }}</span></div>
            <div><span>Gold · GLD</span><span class="v">{{ w.GLD }}</span></div>
          </div>
        </div>

        <div class="grp short">
          <div class="ghd">
            <span class="gname">Short duration</span>
            <span class="gmove"><s>{{ neutral_short }}</s> → <b>{{ w_short }}</b></span>
          </div>
          <div class="gbar"><i style="width:{{ w_short_raw }}%"></i></div>
          <div class="gassets">
            <div><span>Value · IWD</span><span class="v">{{ w.IWD }}</span></div>
            <div><span>Energy · XLE</span><span class="v">{{ w.XLE }}</span></div>
          </div>
        </div>

        <div class="grp def">
          <div class="ghd">
            <span class="gname">Defensive</span>
            <span class="gmove"><s>{{ defensive_pct }}.0%</s> → <b>{{ w_def }}</b></span>
          </div>
          <div class="gbar"><i style="width:{{ w_def_raw }}%"></i></div>
          <div class="gassets">
            <div><span>US 1–3y · SHY</span><span class="v">{{ w.SHY }}</span></div>
            <div class="{{ 'off' if w.IEF_held == false else '' }}"><span>US 7–10y · IEF</span><span class="v">{{ w.IEF }}</span></div>
          </div>
          <p class="gnote">The defensive sleeve switches with the rate signal —
            short duration while rates rise, long when they fall. Duration is a
            hedge in a growth shock and a liability in a rate shock.</p>
        </div>
      </div>

      <div class="tiltcol">
        <div class="alloc-h">How the tilt is applied</div>

        <div class="tilt-tbl">
          <div class="th"></div><div class="th">Neutral</div>
          <div class="th">Tilt</div><div class="th">Today</div>

          <div class="rl">Long duration</div>
          <div class="rv">{{ neutral_long }}</div><div class="rv d">{{ tilt_long }}</div>
          <div class="rv now">{{ w_long }}</div>

          <div class="rl">Short duration</div>
          <div class="rv">{{ neutral_short }}</div><div class="rv d">{{ tilt_short }}</div>
          <div class="rv now">{{ w_short }}</div>

          <div class="rl">Defensive</div>
          <div class="rv">{{ defensive_pct }}.0%</div><div class="rv">—</div>
          <div class="rv now">{{ w_def }}</div>
        </div>

        <div class="formula">tilt = 10pp × score ÷ 3<br>
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;= 10 × ({{ score_signed }}) ÷ 3 =
          <b>{{ tilt_signed }}pp</b></div>

        <p class="tilt-note"><b>Full conviction moves 10 percentage points</b>
          — the most the book will ever lean, and about a quarter of each
          bucket's neutral weight. The tilt is a transfer, not a split: long
          duration gives up 6.7pp and short duration receives the same, so the
          risk budget stays at 55%. Each bucket then divides its new total
          inversely to volatility, so the calmer asset holds more capital.</p>
      </div>
    </div>

    <div class="params">
      <div class="pcard">
        <div class="h">Rates · 2-year Treasury</div>
        <div class="move">{{ rates.from_v }} → {{ rates.to_v }} · <span class="d">{{ rates.change }}</span></div>
        <div class="win">{{ rates.window }}</div>
        <div class="obs">Daily series, one-day publication lag</div>
        <a href="https://fred.stlouisfed.org/series/DGS2" target="_blank"
           rel="noopener">Verify on FRED ↗</a>
      </div>
      <div class="pcard">
        <div class="h">Liquidity · Fed balance sheet</div>
        <div class="move">{{ liq.from_v }} → {{ liq.to_v }} · <span class="d">{{ liq.change }}</span></div>
        <div class="win">{{ liq.window }}</div>
        <div class="obs">Weekly series, dated Wednesday, released Thursday</div>
        <a href="https://fred.stlouisfed.org/series/WALCL" target="_blank"
           rel="noopener">Verify on FRED ↗</a>
      </div>
      <div class="pcard">
        <div class="h">Parameters</div>
        <dl class="dl">
          <dt>Risk budget</dt><dd>{{ budget_pct }} / {{ defensive_pct }}</dd>
          <dt>Tilt applied</dt><dd>{{ tilt_signed }}pp</dd>
          <dt>Rebalance</dt><dd>monthly, 2pp band</dd>
          <dt>Costs</dt><dd>5bp one-way</dd>
        </dl>
      </div>
    </div>

    <p class="foot">
{{ dwell_note }}
    </p>
  </div>
</div>

<div class="s3">
  <div class="c">
    <div class="kicker">Performance</div>
    <h2>Does the tilt actually add anything?</h2>
    <div class="date">{{ sample_range }} · monthly rebalance · transaction costs applied</div>
    <div class="rule2"></div>

    <p class="summary">
      The benchmark is the <b>same six assets held in fixed equal weights</b> —
      {{ bench_eq }} in each risk sleeve, {{ bench_bond }} in each Treasury.
      Bought once, never traded. Same universe, same risk budget, no decisions. SPY is shown as a
      reference line only.
    </p>

    <div class="ctrl">
      <div class="tabs" id="tabs">
        <button class="tab" data-m="12">1Y</button>
        <button class="tab" data-m="60">5Y</button>
        <button class="tab" data-m="120">10Y</button>
        <button class="tab on" data-m="0">Full</button>
      </div>
      <div class="range">
        <span>or</span>
        <input type="month" id="from" min="{{ chart_first }}" max="{{ chart_last }}" value="{{ chart_first }}">
        <span>→</span>
        <input type="month" id="to" min="{{ chart_first }}" max="{{ chart_last }}" value="{{ chart_last }}">
        <button id="apply">Apply</button>
      </div>
    </div>

    <div class="fig" id="fig">
      <div class="fig-t">Cumulative return since start of window, net of costs · log scale</div>
      <div class="fig-s" id="figsub">—</div>
      <svg id="chart" viewBox="0 0 1080 430" role="img"
           aria-label="Cumulative return, strategy against the same book with no tilt"></svg>
      <div class="tip" id="tip"></div>
    </div>

    <div class="kpis" id="kpis"></div>

    <p class="costnote"><b>SPY is shown for scale, not as a benchmark</b> — it
      returned more and fell further. All figures are net of 5bp per trade,
      roughly 0.08% a year at this turnover.</p>

    <div class="verdict">
      <b>The strategy adds {{ edge_full }} of a Sharpe point</b> over holding the
      same six assets in fixed equal weights — {{ sh_strat }} against
      {{ sh_bench }}, on a shallower drawdown. A block bootstrap puts the 95%
      interval at {{ boot_ci }}, p = {{ boot_p }}. It holds in all three
      periods.
    </div>

    <div class="two">
      <div>
        <div class="blk-h">The edge holds in every period</div>
        <table>
          <thead><tr><th>Period</th><th>Strategy</th><th>No tilt</th><th>Gain</th></tr></thead>
          <tbody>
            {% for p in periods %}<tr><td>{{ p.period }}</td><td>{{ p.strategy }}</td>
              <td>{{ p.benchmark }}</td><td class="gain">{{ p.gain }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        <p class="pnote">Excess Sharpe. The window without 2008 shows the
          largest edge, {{ edge_post09 }} against {{ edge_full }} — so the crisis
          isn't what's driving it.</p>
      </div>

      <div>
        <div class="blk-h">The risk level is a mandate choice, not an optimisation</div>
        <table>
          <thead><tr><th>Risk assets</th><th>Return</th><th>Vol</th>
                     <th>Sharpe</th><th>Max DD</th></tr></thead>
          <tbody>
            {% for r in policy %}<tr{{ ' class="pick"' if r.pick else '' }}>
              <td>{{ r.budget }}</td><td>{{ r.ann_return }}</td><td>{{ r.ann_vol }}</td>
              <td>{{ r.sharpe }}</td><td>{{ r.max_dd }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        <p class="pnote">The same strategy at four risk budgets. <b>55% is used
          throughout</b> because it meets a 25% drawdown limit. The risk level is
          a mandate decision, not a model output.</p>
      </div>
    </div>
  </div>
</div>


<div class="s4">
  <div class="c">
    <div class="kicker">Method</div>
    <h2>Twenty tests, one survivor</h2>
    <div class="date">Every variation judged against conditions fixed before it ran</div>
    <div class="rule2"></div>

    <p class="lead">
      Every test was judged against three conditions, fixed in writing beforehand.
      Setting the bar in advance is what separates a test from a search.
      <b>Nineteen of the twenty failed.</b>
    </p>

    <div class="conds">
      <div class="cond">
        <div class="n">01</div>
        <div class="t">Improve risk-adjusted return by more than 0.05 Sharpe</div>
        <p>Anything smaller is inside the noise of a 24-year sample.</p>
      </div>
      <div class="cond">
        <div class="n">02</div>
        <div class="t">Hold in all three time periods</div>
        <p>Full sample, post-crisis, last decade — not just the one that flatters it.</p>
      </div>
      <div class="cond">
        <div class="n">03</div>
        <div class="t">Not raise turnover by more than half</div>
        <p>An improvement paid for in trading costs is not an improvement.</p>
      </div>
    </div>

    <div class="blk-h">Tests</div>
    <table>
      <thead><tr><th>Test</th><th>Result</th></tr></thead>
      <tbody>
        <tr class="kept">
          <td>{{ tests[0].test }}</td>
          <td><span class="tag k">Kept</span>{{ tests[0].note }}</td>
        </tr>
        <tr>
          <td>200-day trend filter</td>
          <td><span class="tag r">Rejected</span>Sharpe 0.98 — the best number of the
            twenty. But almost all of it came from 2008 alone. Remove that one
            year and the advantage nearly disappears.</td>
        </tr>
        <tr>
          <td>PCA correlation warning</td>
          <td><span class="tag r">Rejected</span>Fired a year before 2008 and three
            months before Covid. Sees fragility, not timing.</td>
        </tr>
        <tr>
          <td>Scaling bond duration by score</td>
          <td><span class="tag r">Rejected</span>Worse in every period. Long bonds lose
            when rates rise, so partial exposure is a partial loss with no
            offsetting benefit. In 2022 that cost twice as much: −3.2% against
            −1.6%.</td>
        </tr>
        <tr>
          <td>Sixteen others</td>
          <td><span class="tag r">Rejected</span>Momentum, credit spreads, vol
            targeting, GJR-GARCH, VIX, yield curve, Taylor gap, HRP, currencies,
            and seven more.</td>
        </tr>
      </tbody>
    </table>

    <div class="blk-h">Limitations</div>
    <table>
      <thead><tr><th>Limitation</th><th></th></tr></thead>
      <tbody>
        <tr><td>Growth and value correlate 0.86</td>
            <td>This picks a side of one axis, it doesn't diversify.</td></tr>
        <tr><td>Rates fall in easings and in panics</td>
            <td>The model scores both alike; 2008 went the wrong way.</td></tr>
        <tr><td>The tilt adds +0.036 of the +0.139</td>
            <td>Volatility weighting and the bond switch do most of the work.</td></tr>
        <tr><td>Reads current conditions</td>
            <td>Forecasts nothing.</td></tr>
      </tbody>
    </table>

    <div class="method">
      <div class="q">Why a rule and not a model?</div>
      <p>A Markov model would estimate the regimes from the data, and every
        estimation choice is a degree of freedom a reader cannot audit. This uses
        <span class="five">five fixed numbers</span> — two thresholds, two weights,
        one dwell period — all set in advance and listed above. Anyone can
        recompute the signal from two public FRED series.</p>
    </div>
  </div>
</div>

<footer>
  <div class="c">
    <div class="f-top">
      <div class="f-src">
        <b>Data</b> — Yahoo Finance · FRED, Federal Reserve Bank of St. Louis<br>
        Rebuilt every weekday at 06:15 UTC. Page last built {{ built_utc }}.
      </div>
      <div class="f-links">
        <a class="ph" href="#">Email</a>
        <a class="ph" href="#">LinkedIn</a>
        <a class="ph" href="#">CV</a>
        <a href="#" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="f-legal">
      Research and demonstration purposes. Not investment advice, and not an offer
      or recommendation to buy or sell any security. Originated as coursework for
      Empirical Methods in Finance, HEC Lausanne, and extended into a production
      system.
    </div>
  </div>
</footer>

<script>
(function(){
  const SERIES = {{ chart_json }};
  const N = SERIES.dates.length, RF = {{ rf_rate }};
  const dates = SERIES.dates.map(d => {
    const [y, m] = d.split('-').map(Number);
    return new Date(y, m - 1, 1);
  });
  const series = [SERIES.strategy, SERIES.benchmark, SERIES.spy];
  const maxdd = lr => { let e=1,p=1,d=0;
    lr.forEach(r => { e*=Math.exp(r); p=Math.max(p,e); d=Math.min(d,e/p-1); });
    return d; };

  const X0=64,X1=1058,Y0=24,Y1=280,DY0=322,DY1=396;
  const COL=['#1f77b4','#ff7f0e','#7f7f7f'];   // matplotlib tab10
  const DASH=['','','3 3'];
  const WID=[2.2,2.0,1.4];
  const NM=['Strategy','No tilt','SPY'];
  let cur=[],ddAll=[],xs=null,ys=null,yd=null,i0=0,n=0;

  const stats=lr=>{const k=lr.length,y=k/12;
    const tot=Math.exp(lr.reduce((a,b)=>a+b,0)), ann=Math.pow(tot,1/y)-1;
    const mu=lr.reduce((a,b)=>a+b,0)/k;
    const sd=Math.sqrt(lr.reduce((a,b)=>a+(b-mu)**2,0)/(k-1)), vol=sd*Math.sqrt(12);
    return{ann,vol,sh:(ann-RF)/vol,dd:maxdd(lr),cum:tot-1};};
  const fmt=d=>d.toLocaleDateString('en-GB',{month:'short',year:'numeric'});
  const pctL=p=>(p>0?'+':'')+p.toFixed(0)+'%';

  function draw(a,b){
    i0=a; n=b-a+1; if(n<4)return;
    cur=series.map(s=>{let e=1;const o=[1];
      s.slice(a,b+1).forEach(r=>{e*=Math.exp(r);o.push(e);});return o;});
    ddAll=cur.map(c=>{let p=0;return c.map(v=>{p=Math.max(p,v);return v/p-1;});});

    const all=cur.flat(), lo2=Math.min(...all), hi2=Math.max(...all);
    const llo=Math.log(lo2*0.985), lhi=Math.log(hi2*1.015);
    xs=k=>X0+(X1-X0)*k/n;
    ys=v=>Y1-(Y1-Y0)*(Math.log(v)-llo)/(lhi-llo);

    const worst=Math.min(...ddAll.flat(),-0.02);
    yd=v=>DY0+(DY1-DY0)*(v/worst);

    /* gridlines chosen on PERCENT levels, not index levels */
    const NP=[-60,-50,-40,-30,-20,-10,0,10,25,50,75,100,150,200,300,400,500,750,1000,1500,2000];
    let g=NP.filter(p=>{const v=1+p/100;return v>=lo2*0.985&&v<=hi2*1.015;});
    while(g.length>7) g=g.filter((_,i)=>i%2===0);

    const step=Math.max(1,Math.round(n/7)), tk=[];
    for(let k=0;k<=n;k+=step) tk.push({x:xs(k),t:fmt(dates[Math.min(a+k,N-1)])});

    let h='';
    g.forEach(p=>{const y=ys(1+p/100).toFixed(1);
      h+=`<line x1="${X0}" y1="${y}" x2="${X1}" y2="${y}" stroke="${p===0?'#9AA7AE':'#C9D3D8'}"
            stroke-width="${p===0?1:0.8}" stroke-dasharray="${p===0?'':'1 3'}"/>`
        +`<text x="${X0-10}" y="${(+y+3.5).toFixed(1)}" text-anchor="end" font-size="10.5"
            font-family="ui-monospace,Menlo,monospace" fill="#5F6E76">${pctL(p)}</text>`
        +`<line x1="${X0-5}" y1="${y}" x2="${X0}" y2="${y}" stroke="#5F6E76" stroke-width=".9"/>`;});
    h+=`<line x1="${X0}" y1="${Y0}" x2="${X0}" y2="${Y1}" stroke="#3E4C54"/>`
      +`<line x1="${X0}" y1="${Y1}" x2="${X1}" y2="${Y1}" stroke="#3E4C54"/>`;

    [2,1,0].forEach(k=>{
      const p=cur[k].map((v,j)=>`${xs(j).toFixed(1)},${ys(v).toFixed(1)}`).join(' ');
      h+=`<polyline points="${p}" fill="none" stroke="${COL[k]}" stroke-width="${WID[k]}"
            stroke-linejoin="round" ${DASH[k]?`stroke-dasharray="${DASH[k]}"`:''}/>`;});

    NM.forEach((t,k)=>{const y=Y0+15+k*17;
      h+=`<line x1="${X0+14}" y1="${y-4}" x2="${X0+44}" y2="${y-4}" stroke="${COL[k]}"
            stroke-width="${WID[k]}" ${DASH[k]?`stroke-dasharray="${DASH[k]}"`:''}/>`
        +`<text x="${X0+52}" y="${y}" font-size="11.5" font-family="Inter,sans-serif"
            fill="#3E4C54">${t}${k===2?' — reference only':''}</text>`;});

    /* drawdown panel, all three */
    h+=`<text x="${X0}" y="${DY0-12}" font-size="9.5" letter-spacing="1.1"
          font-family="Inter,sans-serif" fill="#5F6E76">DRAWDOWN FROM PEAK</text>`;
    [0,worst/2,worst].forEach(v=>{const y=yd(v).toFixed(1);
      h+=`<line x1="${X0}" y1="${y}" x2="${X1}" y2="${y}" stroke="#C9D3D8"
            stroke-width=".8" stroke-dasharray="1 3"/>`
        +`<text x="${X0-10}" y="${(+y+3.5).toFixed(1)}" text-anchor="end" font-size="10"
            font-family="ui-monospace,Menlo,monospace" fill="#5F6E76">${(v*100).toFixed(0)}%</text>`;});
    const dpath=k=>ddAll[k].map((v,j)=>`${xs(j).toFixed(1)},${yd(v).toFixed(1)}`).join(' ');
    h+=`<path d="M${xs(0)},${DY0} L${dpath(0).replace(/ /g,' L')} L${xs(n)},${DY0} Z"
          fill="#1f77b4" opacity=".14"/>`;
    [2,1,0].forEach(k=>{h+=`<polyline points="${dpath(k)}" fill="none" stroke="${COL[k]}"
      stroke-width="${k===0?1.8:1.3}" ${DASH[k]?`stroke-dasharray="${DASH[k]}"`:''}/>`;});
    h+=`<line x1="${X0}" y1="${DY1}" x2="${X1}" y2="${DY1}" stroke="#3E4C54"/>`;

    tk.forEach(t=>{h+=`<line x1="${t.x.toFixed(1)}" y1="${DY1}" x2="${t.x.toFixed(1)}"
        y2="${DY1+5}" stroke="#5F6E76" stroke-width=".9"/>`
      +`<text x="${t.x.toFixed(1)}" y="${DY1+19}" text-anchor="middle" font-size="10.5"
          font-family="ui-monospace,Menlo,monospace" fill="#5F6E76">${t.t}</text>`;});

    h+=`<g id="cross" style="display:none">
          <line id="cx" y1="${Y0}" y2="${DY1}" stroke="#3E4C54" stroke-width=".8"
            stroke-dasharray="3 3"/>
          ${[0,1,2].map(k=>`<circle id="c${k}" r="${k===0?3.8:3.2}" fill="${COL[k]}"/>`).join('')}
          ${[0,1,2].map(k=>`<circle id="e${k}" r="${k===0?3.4:2.8}" fill="${COL[k]}"/>`).join('')}
        </g>
        <rect id="hit" x="${X0}" y="${Y0}" width="${X1-X0}" height="${DY1-Y0}"
          fill="transparent" style="cursor:crosshair"/>`;

    document.getElementById('chart').innerHTML=h;
    bindHover();

    const A=stats(series[0].slice(a,b+1)), B=stats(series[1].slice(a,b+1)),
          C=stats(series[2].slice(a,b+1));
    const row=(k,x,y,z,f,w)=>`<div class="kpi${w?' win':''}"><div class="k">${k}</div>
      <b>${f(x)}</b><small>no tilt ${f(y)}</small>
      <small class="ref">SPY ${f(z)}</small></div>`;
    const pc=v=>(v*100).toFixed(2)+'%', p1=v=>(v*100).toFixed(1)+'%', n3=v=>v.toFixed(3);
    document.getElementById('kpis').innerHTML=
       row('Total return',A.cum,B.cum,C.cum,p1,A.cum>B.cum)
      +row('Annualised',A.ann,B.ann,C.ann,pc,A.ann>B.ann)
      +row('Volatility',A.vol,B.vol,C.vol,pc,A.vol<B.vol)
      +row('Sharpe',A.sh,B.sh,C.sh,n3,A.sh>B.sh)
      +row('Max drawdown',A.dd,B.dd,C.dd,p1,A.dd>B.dd)
      +row('Calmar',A.ann/Math.abs(A.dd),B.ann/Math.abs(B.dd),
           C.ann/Math.abs(C.dd),n3,A.ann/Math.abs(A.dd)>B.ann/Math.abs(B.dd));
    document.getElementById('figsub').textContent=
      `${fmt(dates[a])} → ${fmt(dates[b])} · ${n} months · both panels measured from the window start`;
  }

  function bindHover(){
    const svg=document.getElementById('chart'), hit=document.getElementById('hit'),
          gx=document.getElementById('cross'), tip=document.getElementById('tip'),
          fig=document.getElementById('fig'), cx=document.getElementById('cx');
    const cs=[0,1,2].map(k=>document.getElementById('c'+k));
    const es=[0,1,2].map(k=>document.getElementById('e'+k));
    hit.addEventListener('mousemove',ev=>{
      const r=svg.getBoundingClientRect();
      let j=Math.round(((ev.clientX-r.left)/r.width*1080-X0)/(X1-X0)*n);
      j=Math.max(0,Math.min(n,j));
      const x=xs(j);
      gx.style.display=''; cx.setAttribute('x1',x); cx.setAttribute('x2',x);
      cs.forEach((c,k)=>{c.setAttribute('cx',x);c.setAttribute('cy',ys(cur[k][j]));});
      es.forEach((c,k)=>{c.setAttribute('cx',x);c.setAttribute('cy',yd(ddAll[k][j]));});
      const d=dates[Math.min(i0+Math.max(j-1,0),N-1)];
      const pv=v=>((v-1)*100>=0?'+':'')+((v-1)*100).toFixed(1)+'%';
      tip.innerHTML=`<div class="d">${fmt(d)}</div>`
        +`<div class="h">CUMULATIVE RETURN</div>`
        +[0,1,2].map(k=>`<div class="r"><span><i style="background:${COL[k]}"></i>${NM[k]}</span>
            <b>${pv(cur[k][j])}</b></div>`).join('')
        +`<div class="h">DRAWDOWN FROM PEAK</div>`
        +[0,1,2].map(k=>`<div class="r"><span><i style="background:${COL[k]}"></i>${NM[k]}</span>
            <b>${(ddAll[k][j]*100).toFixed(1)}%</b></div>`).join('');
      tip.style.display='block';
      const fr=fig.getBoundingClientRect();
      let L=ev.clientX-fr.left+16;
      if(L>fr.width-215) L-=231;
      tip.style.left=L+'px';
      tip.style.top=Math.max(4,ev.clientY-fr.top-60)+'px';
    });
    hit.addEventListener('mouseleave',()=>{gx.style.display='none';tip.style.display='none';});
  }

  function setWin(a,b){
    a=Math.max(0,a); b=Math.min(N-1,b); draw(a,b);
    const iso=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
    document.getElementById('from').value=iso(dates[a]);
    document.getElementById('to').value=iso(dates[b]);
  }
  document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{
    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
    t.classList.add('on'); const m=+t.dataset.m; setWin(m===0?0:N-m,N-1);}));
  document.getElementById('apply').addEventListener('click',()=>{
    const idx=s=>{const[y,m]=s.split('-').map(Number);
      return dates.findIndex(d=>d.getFullYear()===y&&d.getMonth()===m-1);};
    let a=idx(document.getElementById('from').value), b=idx(document.getElementById('to').value);
    if(a<0)a=0; if(b<0)b=N-1; if(b-a<4) b=Math.min(N-1,a+4);
    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
    setWin(a,b);});
  setWin(0,N-1);
})();
</script>


</body>
</html>
